# 1. Load Eye Dataset (Closed_Eyes vs Open_Eyes)
def load_eye_dataset():
    images, labels = [], []
    
    categories = {
        'Closed': 'eye_data/train/Closed_Eyes',
        'Open':   'eye_data/train/Open_Eyes'
    }
    
    for label, folder_path in categories.items():
        print(f"📥 Loading {label} eyes from: {folder_path}")
        file_list = [f for f in os.listdir(folder_path) if f.lower().endswith(('.png', '.jpg', '.jpeg'))]
        
        for fname in tqdm(file_list[:5000]):
            fpath = os.path.join(folder_path, fname)
            img = cv2.imread(fpath)
            if img is not None:
                img = cv2.resize(cv2.cvtColor(img, cv2.COLOR_BGR2RGB), (128, 128))
                images.append(img)
                labels.append(label)
                
    X = preprocess_input(np.array(images, dtype='float32'))
    return X, np.array(labels)

print("--- 📥 Loading Eye Images ---")
X_eye, y_eye = load_eye_dataset()

le_eye = LabelEncoder()
y_eye_cat = to_categorical(le_eye.fit_transform(y_eye))
print("Classes:", le_eye.classes_) # [0: Closed, 1: Open]
print(f"Total Eye Samples Loaded: {len(X_eye)}")

# Train / Validation Split (80% train, 20% validation)
X_train_e, X_val_e, y_train_e, y_val_e = train_test_split(X_eye, y_eye_cat, test_size=0.2, random_state=42)

# 2. Train Eye MobileNetV2
print("\n--- 🧠 Training MobileNetV2 on Eyes ---")
eye_model = build_mobilenet(num_classes=2, input_shape=(128, 128, 3))

eye_callbacks = [
    EarlyStopping(monitor='val_accuracy', patience=4, restore_best_weights=True),
    ReduceLROnPlateau(monitor='val_accuracy', factor=0.2, patience=2, min_lr=1e-6)
]

history_eye = eye_model.fit(
    X_train_e, y_train_e,
    validation_data=(X_val_e, y_val_e),
    epochs=12,
    batch_size=32,
    callbacks=eye_callbacks
)

# 3. Save Model
eye_model.save("mobilenet_eye_model.h5")
print("\n🎉 Model 1 Complete! Saved as: mobilenet_eye_model.h5")


